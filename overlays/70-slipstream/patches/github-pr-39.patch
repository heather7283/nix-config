From d15ab7f4d7e2c1369f1ba63471a6944ad07b8507 Mon Sep 17 00:00:00 2001
From: "Artem S. Tashkinov" <birdie-github@users.noreply.github.com>
Date: Sat, 3 Oct 2026 19:56:16 +0400
Subject: [PATCH 1/5] server: report unreadable certificate and key files

Check certificate and key file access before initializing PicoQUIC.
Report the failing path and errno reason, suggest checking --cert and
--key, and exit with status 1 instead of failing without a diagnostic.

Fixes #37.
---
 src/slipstream_server_cli.cpp | 24 ++++++++++++++++++++++++
 1 file changed, 24 insertions(+)

diff --git a/src/slipstream_server_cli.cpp b/src/slipstream_server_cli.cpp
index 8ddc45c..4d47cac 100644
--- a/src/slipstream_server_cli.cpp
+++ b/src/slipstream_server_cli.cpp
@@ -1,3 +1,6 @@
+#include <cerrno>
+#include <cstdio>
+#include <cstring>
 #include <iostream>
 #include <string>
 #include <vector>
@@ -24,6 +27,19 @@ struct ServerArgs : MainArguments<ServerArgs> {
 
 const std::string ServerArgs::version = "slipstream-server 0.1";
 
+/* Preflight file access so a missing PEM does not become an unexplained -1. */
+static bool check_readable_file(const std::string& path, const char* description) {
+    FILE* file = std::fopen(path.c_str(), "rb");
+    if (file == NULL) {
+        const int error = errno;
+        std::cerr << "Error: unable to open " << description << " file: "
+                  << path << ": " << std::strerror(error) << std::endl;
+        return false;
+    }
+    std::fclose(file);
+    return true;
+}
+
 int main(int argc, char** argv) {
     int exit_code = 0;
     ServerArgs args(argc, argv);
@@ -47,6 +63,14 @@ int main(int argc, char** argv) {
         exit(1);
     }
 
+    const bool cert_readable = check_readable_file(args.cert, "certificate");
+    const bool key_readable = check_readable_file(args.key, "private key");
+    if (!cert_readable || !key_readable) {
+        std::cerr << "Use --cert PATH and --key PATH to select readable PEM files."
+                  << std::endl;
+        return 1;
+    }
+
     // Process target address
     struct sockaddr_storage target_address;
     char server_name[256];

