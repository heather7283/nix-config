+        (unsigned long long)stream->stream_id, stream->fd,
+        (unsigned long long)stream->tcp_sent, (unsigned long long)stream->tcp_received,
+        stream->pending_bytes, stream->peer_fin, stream->send_fin, operation, strerror(error));
